#!/bin/sh
# Checks commitlint cannot express. Install:
#   cp scripts/commit-msg .git/hooks/ && chmod +x .git/hooks/commit-msg
# Or, with pre-commit, add a commit-msg stage hook that runs this file.
set -eu
msg_file="$1"
subject=$(head -n 1 "$msg_file")
fail=0
say() { echo "commit-msg: $1" >&2; fail=1; }

case "$subject" in
  Merge*|Revert*|fixup!*|squash!*) exit 0 ;;
esac

# Attribution lines outlive their accuracy and clutter git log.
# An indent or a leading emoji does not exempt a line, so normalise first.
norm=$(sed -E 's/^[^A-Za-z]*//' "$msg_file")

if printf '%s\n' "$norm" | grep -qiE '^(co-authored-by|authored by|generated with|generated by|created with|claude-session|claude-code|assisted-by)'; then
  say "attribution line found - remove it"
fi

# A DCO project needs Signed-off-by. Set ALLOW_SIGNOFF=1 there.
if [ "${ALLOW_SIGNOFF:-0}" -eq 0 ] && printf '%s\n' "$norm" | grep -qiE '^signed-off-by'; then
  say "Signed-off-by found - set ALLOW_SIGNOFF=1 if this project uses DCO"
fi

# Hyphen only, everywhere.
if grep -q '—' "$msg_file" || grep -q '–' "$msg_file"; then
  say "long dash found - use a hyphen"
fi

# Structure, and only structure: a type, an optional scope, an optional `!`, a
# colon and a description. The type list itself stays in commitlint, which a
# project extends in one file; a second list here would drift from it silently.
# This runs anyway because a project that installs only this hook still needs
# the type, and `update the parser` is the message it gets without the check.
if ! printf '%s' "$subject" | grep -qE '^[a-z]+(\([a-z0-9._-]+\))?!?: .'; then
  say "no type: expected <type>[(scope)][!]: <description>"
fi

# A trailing period buys nothing and eats one of the 50 characters.
case "$subject" in
  *.) say "trailing period in the subject" ;;
esac

# Description starts lower case, after an optional ticket id.
desc=$(printf '%s' "$subject" | sed -E 's/^[a-z]+(\([a-z0-9._-]+\))?!?: *//; s/^[A-Z][A-Z0-9]+-[0-9]+ *//')
# `[[:upper:]]` and not `[A-Z]`: a glob range walks the locale's collation
# order, and `en_US.UTF-8` orders letters `aAbB...zZ`, so almost every
# lower-case letter sorts inside `A` to `Z`. Under that locale the range
# rejected `run Hephaestus on the host` for a lower-case `r`.
case "$desc" in
  [[:upper:]]*) say "description starts upper case: $desc" ;;
esac

# 50 is the target, 72 is the wall.
len=${#subject}
if [ "$len" -gt 72 ]; then
  say "subject is $len characters, over the 72 limit"
elif [ "$len" -gt 50 ]; then
  echo "commit-msg: subject is $len characters, target is 50" >&2
fi

exit "$fail"
